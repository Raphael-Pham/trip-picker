{
  "name": "trip-picker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:cf": "npx @cloudflare/next-on-pages",
    "preview": "npx wrangler pages dev",
    "deploy": "npm run build:cf && npx wrangler pages deploy",
    "generate:data": "npx tsx scripts/generateDestinationData.ts",
    "generate:data:resume": "npx tsx scripts/generateDestinationData.ts --resume",
    "capture:flights": "npx tsx scripts/captureFlightPrices.ts",
    "capture:flights:resume": "npx tsx scripts/captureFlightPrices.ts --resume",
    "capture:flights:hub": "npx tsx scripts/captureFlightPrices.ts --hub"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@base-ui/react": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "next": "15.3.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "15.3.9",
    "playwright": "^1.61.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "wrangler": "^4.100.0"
  }
}
